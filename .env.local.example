# Shop With Mercy — Local Development Environment Variables
# Copy this file to .env.local and fill in the values.
# Get values from the Netlify dashboard or the respective service dashboards.
# NEVER commit .env.local — it is in .gitignore.

# Supabase (non-secret: safe to share)
PUBLIC_SUPABASE_URL=https://nqiuxsmzccxiicxdlvnd.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase service role key (SECRET — full database access, server-side only)
SUPABASE_SECRET_KEY=

# Cloudinary
PUBLIC_CLOUDINARY_CLOUD_NAME=derhxxq6s
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=shop-with-mercy

# Resend (email)
RESEND_API_KEY=
EMAIL_FROM=support@shopwithmercywears.com

# Paystack
PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
